# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/submitted.co
NEXT_PUBLIC_CONTACT_EMAIL=bit.geniuses.ac@gmail.com

# ── Supabase (requests table + admin auth) ───────────
# Leave blank in local dev to use the .data/requests.json file store
# and the ADMIN_PASSWORD login instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth emails allowed into /admin
ADMIN_EMAILS=

# Crew names for the admin "assign to" menu (server-only, never shown on the public site)
CREW_MEMBERS=

# Only used when Supabase is NOT configured (local dev)
ADMIN_PASSWORD=

# ── Email ────────────────────────────────────────────
# Gmail (works without a domain): a Google App Password from myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend (only if you have a verified domain). Leave all email vars blank to log instead of sending.
RESEND_API_KEY=
RESEND_FROM="SUBMITTED. <hello@your-domain.com>"
# Where new-request alerts go (and reply-to on delivery mails)
CREW_INBOX=

# ── Spam protection (Cloudflare Turnstile, free: dash.cloudflare.com → Turnstile → Add site) ──
# Leave blank to skip the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
